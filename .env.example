# Optional. A GitHub personal access token (no scopes needed for public data).
# Raises the API rate limit from 60 to 5,000 requests per hour.
GITHUB_TOKEN=

# Optional. Public URL of the deployed site, used for absolute Open Graph image URLs.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=
