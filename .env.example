# Optional. A GitHub personal access token (no scopes needed for public data).
# Raises the API rate limit from 60 to 5,000 requests per hour.
GITHUB_TOKEN=

# Optional. Public URL of the site, e.g. https://gitcheckup.vercel.app
# Used for canonical/share-image links, robots.txt and sitemap.xml. On Vercel it can stay
# empty: it falls back to the project's production domain. Read at build time, so redeploy
# after changing it.
NEXT_PUBLIC_SITE_URL=
